      "url": "/compose",
      "icons": [
        {
          "src": "/icons/compose-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml",
          "purpose": "any"
        },
        {
          "src": "/icons/compose-96.svg",
          "sizes": "96x96",
          "type": "image/svg+xml",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "description": "View your messages",
      "url": "/messages",
      "icons": [
        {
          "src": "/icons/messages-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml",
          "purpose": "any"
        },
        {
          "src": "/icons/messages-96.svg",
          "sizes": "96x96",
          "type": "image/svg+xml",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Explore",
      "short_name": "Explore",
      "description": "Discover new content",
      "url": "/explore",
      "icons": [
        {
          "src": "/icons/explore-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml",
          "purpose": "any"
        },
        {
          "src": "/icons/explore-96.svg",
          "sizes": "96x96",
          "type": "image/svg+xml",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Notifications",
      "short_name": "Notifs",
      "description": "Check your notifications",
      "url": "/",
      "icons": [
        {
          "src": "/icons/notifications-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml",
          "purpose": "any"
        },
        {
          "src": "/icons/notifications-96.svg",
          "sizes": "96x96",
          "type": "image/svg+xml",
          "purpose": "any"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  },
  "handle_links": "preferred",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "launch_handler": {
    "client_mode": ["navigate-new", "auto"]
  },
  "categories": ["social", "communication"],
  "lang": "en",
