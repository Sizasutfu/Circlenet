{
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "{{ .Env.NEXT_PUBLIC_API_BASE_URL }}/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "{{ .Env.NEXT_PUBLIC_API_BASE_URL }}/uploads/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/feed",
      "permanent": true
    }
  ]
}