{
  "name": "Circlenet",
  "short_name": "Circle",
  "description": "CircleNet — where real connections happen. Share moments, join conversations, and grow your community.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "background_color": "#0a0a0d",
  "theme_color": "#7c6bff",
  "orientation": "portrait-primary",
  "scope": "/",
  "icons": [
    {
      "src": "icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile.png",
      "sizes": "722x1286",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/screenshots/desktop.png",
      "sizes": "1910x972",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "shortcuts": [
    {
      "name": "New Post",
