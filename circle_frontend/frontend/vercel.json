{
  "rewrites": [
    {
      "source": "/post/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*)(googlebot|bingbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|applebot|discordbot|slackbot|pinterestbot)(.*)"
        }
      ],
      "destination": "https://circleappapp-production.up.railway.app/post/:id"
    },
    {
      "source": "/profile/:userId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*)(googlebot|bingbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|applebot|discordbot|slackbot|pinterestbot)(.*)"
        }
      ],
      "destination": "https://circleappapp-production.up.railway.app/profile/:userId"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://circleappapp-production.up.railway.app/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://circleappapp-production.up.railway.app/robots.txt"
    },
    {
      "source": "/articles/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*)(googlebot|bingbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|applebot|discordbot|slackbot|pinterestbot)(.*)"
        }
      ],
      "destination": "https://circleappapp-production.up.railway.app/articles/:slug"
    },
    {
      "source": "/articles/:slug",
      "destination": "http://blog.circlenet.social/articles/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}